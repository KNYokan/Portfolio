---

<HomeLayout title="Accueil">
  <main class="accueil">
    <section
      class="intro text-center flex flex-col items-center px-4 pt-12 sm:pt-24 md:pt-28"
    >
      <h1 class="text-3xl md:text-4xl font-bold max-w-2xl">
        Hey, je suis Paul KARAS
      </h1>
      <h2 class="text-lg md:text-xl mt-4">
        Étudiant en Développement Web, pour devenir Chef de Projets Digitaux
      </h2>
      <h3 class="text-base mt-2">
        Actuellement en recherche d'une alternance pour septembre 2025 à Rouen
      </h3>

      <img
        src="/images/Paul-KARAS-Working.png"
        alt="Paul Karas"
        class="mt-12 w-44 sm:w-40 md:w-76 max-w-full object-cover rounded-xl shadow-lg"
      />
    </section>
    <Carrousel />
    <div class="mt-16 sm:mt-20 md:mt-24"></div>
  </main>
</HomeLayout>
