---
import Carrousel from "../components/Carrousel.astro";
import HomeLayout from "../layouts/HomeLayout.astro";
import Cv from "../components/Cv.astro";
import Recherche from "../components/Recherche.astro";
---

<HomeLayout title="Accueil">
  <main class="accueil">
    <section
      class="intro text-center flex flex-col items-center px-4 pt-12 sm:pt-24 md:pt-28"
    >
      <Recherche />

      <h1 class="text-3xl md:text-4xl font-bold max-w-2xl">
        Hey, je suis Paul KARAS
      </h1>
      <h2 class="text-base mt-2">
        Étudiant en Communication Graphique, pour devenir Chef de Projets
        Digitaux
      </h2>

      <img
        src="/images/Paul-KARAS-Working.png"
        alt="Paul Karas"
        class="mt-12 w-44 sm:w-40 md:w-72 max-w-full object-cover rounded-xl"
      />
    </section>
    <Carrousel />
    <div class="mt-16 sm:mt-20 md:mt-24"></div>
    <Cv />
  </main>
</HomeLayout>
