---
import BaseLayout from "../layouts/BaseLayout.astro";
import ContactForm from "../components/ContactForm.astro";

const contacts = [
  {
    title: "Email",
    link: "mailto:paul.karas@normandiewebschool.fr",
    label: "M’envoyer un mail",
  },
  {
    title: "GitHub",
    link: "https://github.com/KNYokan",
    label: "Voir mon GitHub",
  },
  {
    title: "LinkedIn",
    link: "https://www.linkedin.com/in/paul-karas-445642332/",
    label: "Voir mon profil",
  },
];
---

<BaseLayout>
  <section class="max-w-4xl mx-auto px-4 py-16 text-primary">
    <div class="text-center mb-6">
      <p
        class="inline-block bg-primary text-secondary-background font-semibold px-4 py-2 rounded-full shadow"
      >
        Disponible pour une alternance dès septembre 2025
      </p>
    </div>
    <h1 class="text-3xl font-bold mb-12 text-center">Contact</h1>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-16">
      {
        contacts.map(({ title, link, label }) => (
          <div class="p-6 rounded-xl shadow-md bg-secondary-background hover:shadow-lg transition flex flex-col justify-between">
            <h2 class="text-xl text-center font-bold mb-4">{title}</h2>
            <a
              href={link}
              target="_blank"
              class="bg-primary text-secondary-background text-center font-semibold px-6 py-2 rounded hover:bg-opacity-90 transition"
            >
              {label}
            </a>
          </div>
        ))
      }
    </div>

    <ContactForm />
  </section>
</BaseLayout>
