---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Particles from "../components/Particles.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
const { title } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      rel="icon"
      type="image/svg+xml+png"
      href="/images/Paul KARAS Animoji.png"
    />
    <title>{"Portfolio de Paul KARAS"}</title>
  </head>
  <body class="bg-secondary-foreground text-primary relative">
    <Particles class="absolute top-0 left-0 w-full h-full -z-10" />
    <Header class="font-normal" />
    <ThemeToggle />

    <main class="relative z-10">
      <slot />
    </main>

    <Footer />
  </body>
</html>
