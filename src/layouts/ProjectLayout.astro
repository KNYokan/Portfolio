---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Particles from "../components/Particles.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import ProjectLinkButton from "../components/ProjectLinkButton.astro";
import ProjectDownloadButton from "../components/ProjectDownloadButton.astro";
import BackButton from "../components/BackButton.astro";
const { title, image, image2, image3, link, pdf, Content } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} – Projet</title>
    <meta name="description" content={`Page du projet ${title}`} />
    <link
      rel="icon"
      type="image/svg+xml+png"
      href="/images/Paul KARAS Animoji.png"
    />
  </head>

  <body class="bg-background text-primary">
    <Header class="font-normal" />
    <Particles class="absolute top-0 left-0 w-full h-full -z-10" />
    <main class="max-w-5xl mx-auto py-20 px-6 space-y-20">
      <div class="space-y-10">
        <h1 class="text-4xl font-bold text-center">{title}</h1>

        {
          !image2 && !image3 && (
            <div class="overflow-hidden rounded-xl aspect-square max-w-md mx-auto shadow-md">
              <img
                src={image}
                alt={`Image principale du projet ${title}`}
                class="w-full h-full object-cover"
              />
            </div>
          )
        }

        {
          image && image2 && !image3 && (
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
              <div class="overflow-hidden rounded-xl aspect-square shadow-md">
                <img
                  src={image}
                  alt={`Image principale du projet ${title}`}
                  class="w-full h-full object-cover"
                />
              </div>
              <div class="overflow-hidden rounded-xl aspect-square shadow-md">
                <img
                  src={image2}
                  alt={`Deuxième image du projet ${title}`}
                  class="w-full h-full object-cover object-[center_20%]"
                />
              </div>
            </div>
          )
        }

        {
          image && image2 && image3 && (
            <div class="space-y-10">
              <div class="overflow-hidden rounded-xl aspect-square max-w-md mx-auto shadow-md">
                <img
                  src={image}
                  alt={`Image principale du projet ${title}`}
                  class="w-full h-full object-cover"
                />
              </div>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
                <div class="overflow-hidden rounded-xl aspect-square shadow-md">
                  <img
                    src={image2}
                    alt={`Deuxième image du projet ${title}`}
                    class="w-full h-full object-cover"
                  />
                </div>
                <div class="overflow-hidden rounded-xl aspect-square shadow-md">
                  <img
                    src={image3}
                    alt={`Troisième image du projet ${title}`}
                    class="w-full h-full object-cover"
                  />
                </div>
              </div>
            </div>
          )
        }
      </div>

      <div
        class="prose prose-invert max-w-none backdrop-blur-sm rounded-xl px-5 py-5 space-y-6"
      >
        <Content />
      </div>

      {
        link && (
          <div class="flex justify-center">
            <ProjectLinkButton link={link} />
          </div>
        )
      }
      {
        pdf && (
          <div class="flex justify-center">
            <ProjectDownloadButton pdf={pdf} />
          </div>
        )
      }
    </main>
    <div class="max-w-5xl mx-auto mb-4 px-2">
      <div class="pt-10 mt-10 border-t border-primary flex justify-start">
        <BackButton href="/projects" label="projets" />
      </div>
    </div>
    <ThemeToggle class="my-12" />
    <Footer />
  </body>
</html>
