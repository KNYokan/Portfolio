---

---

<form
  action="https://formspree.io/f/mzzgzyel"
  method="POST"
  class="bg-secondary-background p-6 rounded-xl shadow-md space-y-6 max-w-xl mx-auto"
>
  {
    ["Nom", "Email", "Message"].map((label) => {
      const id = label.toLowerCase();
      const isTextarea = id === "message";

      return (
        <div>
          <label for={id} class="block font-medium mb-1">
            {label}
          </label>
          {isTextarea ? (
            <textarea
              id={id}
              name={id}
              rows="5"
              required
              class="w-full px-4 py-2 rounded border bg-secondary-background text-primary"
            />
          ) : (
            <input
              type={id === "email" ? "email" : "text"}
              id={id}
              name={id}
              required
              class="w-full px-4 py-2 rounded border bg-secondary-background text-primary"
            />
          )}
        </div>
      );
    })
  }

  <div class="text-center">
    <button
      type="submit"
      class="bg-primary text-secondary-background font-semibold px-6 py-2 rounded transition"
    >
      Envoyer
    </button>
  </div>
</form>
