---
const { href = "/projects", label = "projets" } = Astro.props;
---

<a href={href} class="inline-block">
  <button
    type="button"
    class="relative w-36 h-10 backdrop-blur border-primary box-shadow border-4 text-primary hover:underline text-xl font-semibold bg-secondary-bakground rounded-full group text-center overflow-hidden"
  >
    <div
      class="absolute h-12 w-1/4 left-3 top-1 bg-secondary-bakground rounded-xl"
    >
      <svg
        width="25"
        height="25"
        viewBox="0 0 1024 1024"
        xmlns="http://www.w3.org/2000/svg"
        class="text-primary"
        stroke="currentColor"
        stroke-width="6"
        fill="currentColor"
      >
        <path d="M224 480h640a32 32 0 1 1 0 64H224a32 32 0 0 1 0-64z"></path>
        <path
          d="m237.248 512 265.408 265.344a32 32 0 0 1-45.312 45.312l-288-288a32 32 0 0 1 0-45.312l288-288a32 32 0 1 1 45.312 45.312L237.248 512z"
        ></path>
      </svg>
    </div>
    <p class="translate-x-4 relative z-20">Retour</p>
  </button>
</a>
