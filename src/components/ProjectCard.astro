---
const { title, slug, image, description } = Astro.props;
---

<article
  class="group relative flex flex-col h-full rounded-xl overflow-hidden shadow-md bg-secondary-background hover:shadow-xl transition duration-300"
>
  <figure class="overflow-hidden h-[280px]">
    <img
      src={image}
      alt={`Image du projet ${title}`}
      class="w-full h-90 object-cover transition-transform duration-300 group-hover:scale-105"
    />
  </figure>
  <div class="p-4">
    <h2 class="text-lg font-bold text-primary group-hover:underline">
      {title}
    </h2>
    <p class="text-primary text-sm mt-1">{description}</p>

    <a class="absolute inset-0" href={`/projects/${slug}`}>
      <span class="sr-only">{`Découvrir le projet ${title}`}</span>
    </a>
  </div>
</article>
