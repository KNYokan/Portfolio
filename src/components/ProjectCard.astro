---
const { title, image, slug, description, compact = false } = Astro.props;

// Hauteurs équilibrées
const bandHeight = compact ? "h-[120px]" : "h-[160px]";
const figureHeight = compact ? "h-[260px]" : "h-[220px]";
const bandPadding = compact ? "p-3" : "p-4";
const descClamp = compact ? "line-clamp-2" : "line-clamp-3";
---

<article
  class="group relative flex flex-col w-full h-[380px] rounded-xl overflow-hidden shadow-md bg-secondary-background hover:shadow-xl transition duration-300"
>
  <figure class={`overflow-hidden ${figureHeight}`}>
    <img
      src={image}
      alt={`Image du projet ${title}`}
      class="w-full h-full object-cover transition-transform duration-300 group-hover:scale-105"
      loading="lazy"
    />
  </figure>

  <div
    class={`flex flex-col justify-between ${bandPadding} ${bandHeight} gap-2`}
  >
    <h2
      class="text-lg font-bold text-primary group-hover:underline line-clamp-1"
    >
      {title}
    </h2>
    <p class={`text-primary text-sm ${descClamp}`}>
      {description}
    </p>
  </div>

  <a
    class="absolute inset-0"
    href={`/projects/${slug}`}
    aria-label={`Découvrir le projet ${title}`}></a>
</article>
