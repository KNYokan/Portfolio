---
import Logo from "./Logo.astro";
import Navigation from "./Navigation.astro";
import Burger from "./ui/Burger.astro";
---

<header
  id="main-header"
  class="sticky top-0 z-50 transition-transform duration-300 bg-transparent backdrop-blur-md px-6 py-4"
>
  <div class="mx-auto flex max-w-7xl items-center justify-between">
    <a href="/" class="block w-[150px] lg:w-[200px]">
      <Logo />
    </a>
    <Navigation id="main-nav" />
    <Burger id="burger-toggle" />
  </div>

  <script is:inline>
    const header = document.getElementById("main-header");
    const burgerMenu = document.getElementById("burger-toggle");
    const navContainer = document.getElementById("main-nav");
    let lastScroll = 0;
    let isActive = false;

    window.addEventListener("scroll", () => {
      const currentScroll = window.pageYOffset;
      if (currentScroll > lastScroll && currentScroll > 100) {
        header.style.transform = "translateY(-100%)";
      } else {
        header.style.transform = "translateY(0)";
      }
      lastScroll = currentScroll;
    });

    if (burgerMenu && navContainer) {
      burgerMenu.addEventListener("click", () => {
        isActive = !isActive;
        navContainer.classList.toggle("hidden");
        navContainer.classList.toggle("flex");
        navContainer.classList.toggle("fixed");
        navContainer.classList.toggle("inset-0");
        navContainer.classList.toggle("backdrop-blur-xl");
        navContainer.classList.toggle("bg-white/70");
        navContainer.classList.toggle("items-center");
        navContainer.classList.toggle("justify-center");
        navContainer.classList.toggle("z-50");
        burgerMenu.classList.toggle("is-active");
        burgerMenu.setAttribute("aria-expanded", String(isActive));
        burgerMenu.setAttribute(
          "aria-label",
          isActive ? "Fermer le menu" : "Ouvrir le menu"
        );
      });
    }
  </script>
</header>
