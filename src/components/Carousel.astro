---
import ProjectCard from "./ProjectCard.astro";
import { getCollection } from "astro:content";

const projects = await getCollection("projects");
---

<section class="my-16 px-4 relative">
  <h2 class="text-2xl font-bold text-center mb-6">Mes projets récents</h2>

  <div
    id="carousel-container"
    class="flex gap-4 overflow-x-auto pb-4 scroll-smooth"
  >
    {
      projects.map((project) => {
        const { title, slug, image, description } = project.data;

        return (
          <div class="min-w-[300px] flex-shrink-0">
            <ProjectCard
              title={title}
              slug={slug}
              image={image}
              description={description}
            />
          </div>
        );
      })
    }
  </div>

  <div class="flex justify-between items-center mt-6">
    <button
      onclick="document.getElementById('carousel-container').scrollBy({ left: -320, behavior: 'smooth' })"
      class="bg-secondary-background border rounded-2xl shadow p-2 hover:brightness-105"
      aria-label="Défiler à gauche"
    >
      ❮
    </button>

    <button
      onclick="document.getElementById('carousel-container').scrollBy({ left: 320, behavior: 'smooth' })"
      class="bg-secondary-background border rounded-2xl shadow p-2 hover:brightness-105"
      aria-label="Défiler à droite"
    >
      ❯
    </button>
  </div>
</section>

<script>
  const cards = document.querySelectorAll("#carousel-container article");
  console.log(cards);
</script>
