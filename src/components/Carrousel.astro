---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import ProjectCard from "./ProjectCard.astro";

const projects: CollectionEntry<"projects">[] = await getCollection("projects");
const visibleSlides = 1;
const totalPages = Math.ceil(projects.length / visibleSlides);
---

<section class="my-16 px-4 relative max-w-screen-xl mx-auto">
  <h2 class="hover:underline text-2xl font-bold text-center mb-6">
    <a href="/projects">Mes projets récents</a>
  </h2>

  <div class="relative">
    <div
      id="carousel"
      class="flex overflow-x-auto scroll-smooth gap-4 snap-x snap-mandatory pb-2"
    >
      {
        projects.map((project) => {
          const { title, image, description } = project.data;
          const { slug } = project;

          return (
            <div class="min-w-[80%] sm:min-w-[50%] md:min-w-[33%] lg:min-w-[25%] snap-start">
              <ProjectCard
                title={title}
                slug={slug}
                image={image}
                description={description}
              />
            </div>
          );
        })
      }
    </div>

    <div class="flex justify-between items-center mt-6 px-6">
      <button
        id="prev"
        class="p-3 rounded-full bg-secondary-background shadow hover:scale-105 transition"
        aria-label="Précédent"
      >
        ❮
      </button>
      <button
        id="next"
        class="p-3 rounded-full bg-secondary-background shadow hover:scale-105 transition"
        aria-label="Suivant"
      >
        ❯
      </button>
    </div>

    <div class="flex justify-center gap-2 mt-4" id="dots-container">
      {
        Array.from({ length: totalPages }).map((_, index) => (
          <button
            class="w-3 h-3 rounded-full bg-gray-400 opacity-50 transition"
            data-index={index}
            aria-label={`Aller à la page ${index + 1}`}
          />
        ))
      }
    </div>
  </div>

  <script is:inline>
    const carousel = document.getElementById("carousel");
    const prev = document.getElementById("prev");
    const next = document.getElementById("next");
    const dots = document.querySelectorAll("#dots-container button");

    let currentIndex = 0;

    function getSlideWidth() {
      const slide = carousel.querySelector("div");
      if (!slide) return 0;
      const style = getComputedStyle(slide);
      const marginRight = parseInt(style.marginRight || "0");
      return slide.offsetWidth + marginRight;
    }

    function updateScroll() {
      const slideWidth = getSlideWidth();
      carousel.scrollTo({
        left: currentIndex * slideWidth,
        behavior: "smooth",
      });
      updateDots();
    }

    function updateDots() {
      dots.forEach((dot, i) => {
        dot.classList.toggle("bg-primary", i === currentIndex);
        dot.classList.toggle("opacity-100", i === currentIndex);
        dot.classList.toggle("opacity-50", i !== currentIndex);
      });
    }

    prev.addEventListener("click", () => {
      currentIndex = Math.max(currentIndex - 1, 0);
      updateScroll();
    });

    next.addEventListener("click", () => {
      currentIndex = Math.min(currentIndex + 1, dots.length - 1);
      updateScroll();
    });

    dots.forEach((dot) => {
      dot.addEventListener("click", () => {
        currentIndex = parseInt(dot.dataset.index);
        updateScroll();
      });
    });

    updateDots(); // Initialisation
  </script>
</section>
