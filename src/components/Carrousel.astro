---
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import ProjectCard from "./ProjectCard.astro";

const projects: CollectionEntry<"projects">[] = await getCollection("projects");
const visibleSlides = 1;
const totalPages = Math.ceil(projects.length / visibleSlides);
---

<section class="my-16 px-4 relative max-w-screen-xl mx-auto">
  <h2 class="hover:underline text-2xl font-bold text-center mb-6">
    <a href="/projects">Mes projets récents</a>
  </h2>

  <div class="relative">
    <div
      id="carousel"
      class="flex overflow-x-auto scroll-smooth gap-4 snap-x snap-mandatory pb-2"
    >
      {
        projects.map((project) => {
          const { title, image, description } = project.data;
          const { slug } = project;

          return (
            <div class="min-w-[80%] sm:min-w-[50%] md:min-w-[33%] lg:min-w-[25%] snap-start">
              <ProjectCard
                title={title}
                slug={slug}
                image={image}
                description={description}
              />
            </div>
          );
        })
      }
    </div>

    <div class="flex justify-between items-center mt-6 px-6">
      <button
        id="prev"
        class="p-3 rounded-full bg-secondary-background shadow hover:scale-105 transition"
        aria-label="Précédent"
      >
        ❮
      </button>
      <button
        id="next"
        class="p-3 rounded-full bg-secondary-background shadow hover:scale-105 transition"
        aria-label="Suivant"
      >
        ❯
      </button>
    </div>
  </div>

  <script is:inline>
    const carousel = document.getElementById("carousel");
    const prev = document.getElementById("prev");
    const next = document.getElementById("next");
    const dots = document.querySelectorAll("#dots-container button");

    const slides = Array.from(carousel.children);
    let currentIndex = 0;

    function getGap() {
      const style = getComputedStyle(carousel);
      return parseFloat(style.columnGap || style.gap || "0") || 0;
    }

    function getSlideWidth() {
      const slide = slides[0];
      if (!slide) return 0;
      return slide.getBoundingClientRect().width + getGap();
    }

    function maxIndex() {
      return Math.max(slides.length - 1, 0);
    }

    function updateScroll() {
      const slideWidth = getSlideWidth();
      carousel.scrollTo({
        left: Math.max(0, currentIndex * slideWidth),
        behavior: "smooth",
      });
      updateDots();
    }

    function updateDots() {
      if (!dots.length) return;
      dots.forEach((dot, i) => {
        dot.classList.toggle("bg-primary", i === currentIndex);
        dot.classList.toggle("opacity-100", i === currentIndex);
        dot.classList.toggle("opacity-50", i !== currentIndex);
      });
    }

    prev.addEventListener("click", () => {
      currentIndex = Math.max(currentIndex - 1, 0);
      updateScroll();
    });

    next.addEventListener("click", () => {
      currentIndex = Math.min(currentIndex + 1, maxIndex());
      updateScroll();
    });

    dots.forEach((dot) => {
      dot.addEventListener("click", () => {
        currentIndex = parseInt(dot.dataset.index);
        updateScroll();
      });
    });

    updateDots();
  </script>
</section>
