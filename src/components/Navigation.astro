---
const { id, items } = Astro.props;

type NavItemType = {
  label: string;
  url: string;
};
---

<nav
  id={id}
  class="flex flex-col items-center gap-8 text-center lg:flex-row lg:gap-8"
>
  {
    items.map((item: NavItemType) => (
      <a
        href={item.url}
        class="font-bold px-6 py-2 rounded-3xl bg-white/10 backdrop-blur-lg hover:bg-white/20 transition"
      >
        {item.label}
      </a>
    ))
  }
</nav>
