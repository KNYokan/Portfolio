---
const { id, items } = Astro.props;

type NavItemType = {
  label: string;
  url: string;
};
---

<nav
  id={id}
  class="hidden fixed inset-0 z-40 flex-col items-center justify-center gap-8 text-center
         lg:static lg:flex lg:flex-row lg:gap-8 lg:bg-transparent lg:backdrop-blur-0"
>
  {
    items.map((item: NavItemType) => (
      <a
        href={item.url}
        class="w-44 max-w-[90%] text-xl px-6 py-3 rounded-3xl  bg-black/20 hover:bg-secondary-background/60 hover:outline-1 hover:outline-secondary-background transition"
      >
        {item.label}
      </a>
    ))
  }
</nav>
